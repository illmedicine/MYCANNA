rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ────────────────────────────────────────────────────
    // Each user can read and write only their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Cannabis insights (seeded data) ──────────────────────────────────
    // Publicly readable by any authenticated user.
    // Write access is blocked from the client — seed via Firebase Admin SDK only.
    match /insights/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Catch-all: deny everything else ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
