rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin helper ──────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'dwilson@illyrobotic-ai.com',
        'jcgstone@yahoo.com',
        'demarkuswilsone@gmail.com'
      ];
    }

    // ── Users ────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Leaderboard — public read, only backend writes ───────────────────
    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == entry;
    }

    // ── Vendors ──────────────────────────────────────────────────────────
    match /vendors/{vendorId} {
      allow read: if true;
      // addDoc creates auto-ID docs so we no longer require uid == vendorId
      allow create: if request.auth != null;
      // Owner, any co-owner in ownerEmails, or platform admins can update
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        (resource.data.ownerEmails is list &&
          request.auth.token.email in resource.data.ownerEmails) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Products ─────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.vendorId ||
        isAdmin()
      );
    }

    // ── Orders (wholesale catalog orders) ────────────────────────────────
    // Anyone can place an order (public catalog is accessible without login).
    // Only the vendor owner, co-owner, or admin can read/update orders.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if request.auth != null && (
        request.auth.uid == resource.data.vendorOwnerId ||
        isAdmin()
      );
    }

    // ── Experiences ──────────────────────────────────────────────────────
    match /experiences/{expId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // ── Insights (seeded data) ────────────────────────────────────────────
    match /insights/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Stats ─────────────────────────────────────────────────────────────
    match /stats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Activity feed ──────────────────────────────────────────────────────
    match /activity/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                 && request.resource.data.createdAt is timestamp
                 && request.resource.data.type is string;
    }

    // ── Presence ──────────────────────────────────────────────────────────
    match /presence/{sessionId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['lastSeen'])
                && request.resource.data.lastSeen is timestamp;
    }

    // ── Visits ────────────────────────────────────────────────────────────
    match /visits/{sessionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['at'])
                 && request.resource.data.at is timestamp;
    }

    // ── Deny all else ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
