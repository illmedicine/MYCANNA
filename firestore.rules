rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Leaderboard — public read, only backend writes ───────────────────
    match /leaderboard/{entry} {
      allow read: if true;
      // Written by the user's own client via prestigeService only
      allow write: if request.auth != null && request.auth.uid == entry;
    }

    // ── Vendors ──────────────────────────────────────────────────────────
    // Public read so unauthenticated users can browse the Discover page.
    // Only the vendor owner can create/update their own doc.
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == vendorId;
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // ── Products ─────────────────────────────────────────────────────────
    // Public read for the marketplace; writable only by the owning vendor.
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.vendorId;
    }

    // ── Experiences ──────────────────────────────────────────────────────
    // Users write their own; read access scoped to owner only for now.
    match /experiences/{expId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // ── Insights (seeded data) ────────────────────────────────────────────
    // Public read, no client writes.
    match /insights/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Stats (public read, authenticated increment-only writes) ─────────
    match /stats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Activity feed — real platform events, append-only ─────────────────
    // Authenticated users can create events (no update/delete).
    // Public read so the live toast can show events to all visitors.
    match /activity/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                 && request.resource.data.createdAt is timestamp
                 && request.resource.data.type is string;
    }

    // ── Presence — live active-user heartbeat ─────────────────────────────
    // Any visitor can write only { lastSeen: timestamp } — no other fields.
    match /presence/{sessionId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['lastSeen'])
                && request.resource.data.lastSeen is timestamp;
    }

    // ── Visits — all-time unique session counter ───────────────────────────
    // Create-only, one doc per session ID, only { at: timestamp } allowed.
    match /visits/{sessionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['at'])
                 && request.resource.data.at is timestamp;
    }

    // ── Deny all else ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
